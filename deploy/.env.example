# Variáveis do projeto "enadex" no Docker Manager da Hostinger.
# Os SEGREDOS são preenchidos só no hPanel (Docker Manager -> enadex -> variáveis). Nunca neste repositório.

# Versões das imagens (tag "main" ou o sha de 12 caracteres publicado pelo CI; trocar a tag é o rollback).
API_TAG=main
WEB_TAG=main
EDGE_TAG=main

# Supabase do grupo: SUPABASE_URL é só a referência do projeto (sem https:// nem .supabase.co).
SUPABASE_URL=
# Chave de serviço (secreta).
SUPABASE_KEY=
# DSN do papel somente leitura enade_time_reader pelo Session Pooler (secreto).
ENADE_TIME_DB_URL=
# Token do POST /api/e-xplainenade/dataset/refresh (aleatório; a rota fica bloqueada na borda de qualquer forma).
EXPLAINENADE_REFRESH_TOKEN=
# Chave do Gemini para as descrições automáticas do EduCluster (secreta; cache em disco, forcar=true bloqueado).
GEMINI_API_KEY=
